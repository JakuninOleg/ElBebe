---
import '../styles/el-bebe-fonts.css';
import nunitoCyrillic from '@fontsource-variable/nunito-sans/files/nunito-sans-cyrillic-wght-normal.woff2?url';
const nunitoLatin = '/fonts/nunito-common-wght-v1.woff2';
const nunitoSymbols = '/fonts/nunito-ruble-wght-v1.woff2';
import '../styles/el-bebe-caveat.css';
import '../styles/el-bebe.css';
import '../styles/el-bebe-refinements.css';
import '../styles/el-bebe-invitation.css';
import '../styles/el-bebe-family.css';
import '../styles/el-bebe-mobile-hero.css';
import '../styles/el-bebe-rates.css';
import '../styles/el-bebe-groups-visit.css';
import '../styles/el-bebe-first-days.css';
import '../styles/el-bebe-icon-art.css';
import '../styles/el-bebe-content.css';
import '../styles/el-bebe-brand.css';
import '../styles/el-bebe-group-cards.css';
import '../styles/el-bebe-editorial.css';
import '../styles/el-bebe-layout-polish.css';
import '../styles/el-bebe-journey.css';
import '../styles/el-bebe-navigation.css';
import '../styles/el-bebe-legal.css';
import '../styles/el-bebe-not-found.css';
import '../styles/el-bebe-real-photos.css';
import '../styles/el-bebe-life-album.css';
import '../styles/el-bebe-form-states.css';
import ArtDefs from '../components/el-bebe/ArtDefs.astro';
import Header from '../components/el-bebe/Header.astro';
import Footer from '../components/el-bebe/Footer.astro';
import VisitDialog from '../components/el-bebe/VisitDialog.astro';
import PrivacyChoices from '../components/el-bebe/PrivacyChoices.astro';
import { resolveContacts, type SiteContacts } from '../data/site-contacts';
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd, createPublicPageContext } from '../lib/emdash-ui';
interface Props { title: string; description: string; address?: string; phone?: string; contacts?: SiteContacts; }
const { title, description, contacts = resolveContacts() } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const page = createPublicPageContext({ Astro, kind: 'custom', pageType: 'website', title, pageTitle: title, description, canonical, image: '/images/el-bebe/real-outdoor-play-v1.webp', siteName: 'Эльбэби', seo: { robots: 'noindex, nofollow' } });
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#fffdf7"/>
    <title>{title}</title>
    <slot name="head"/>
    <link rel="preload" href={nunitoCyrillic} as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href={nunitoSymbols} as="font" type="font/woff2" crossorigin/>
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico?v=approved-bunny"/>
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-bunny-16.png?v=approved-bunny"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-bunny-32.png?v=approved-bunny"/>
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=approved-bunny"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=approved-bunny"/>
    <EmDashHead page={page}/>
  </head>
  <body>
    <ArtDefs/><EmDashBodyStart page={page}/><a class="skip-link" href="#main">Перейти к содержанию</a>
    <Header/><main id="main"><slot/></main><Footer contacts={contacts}/><VisitDialog/><PrivacyChoices/>
    <EmDashBodyEnd page={page}/>
    <script>import '../scripts/el-bebe';</script>
  </body>
</html>
