---
import Layout from './ElBebe.astro';
import Callout from '../components/el-bebe/Callout.astro';
import { getSiteContent } from '../lib/cms';
import PageIntro from '../components/el-bebe/PageIntro.astro';
interface Props { title: string; heading: string; description: string; label?: string; intro?: string; callout?: boolean; art?: string; note?: string; mascot?: boolean; parent?: { href: string; label: string }; }
const { title, heading, description, label, intro = description, callout = true, art, note, mascot, parent } = Astro.props;
const { settings } = await getSiteContent();
const pageArt: Record<string, string> = { '/stoimost/': 'apple', '/den-v-sadu/': 'sun', '/komanda/': 'people', '/prostranstvo/': 'home', '/roditelyam/': 'chat', '/kontakty/': 'pin', '/svedeniya/': 'document', '/privacy/': 'shield', '/soglasie/': 'document' };
const pageNotes: Record<string, string> = { '/den-v-sadu/': 'У каждого дня — свой ритм', '/komanda/': 'Рядом каждый день', '/prostranstvo/': 'Место для открытий', '/roditelyam/': 'Чтобы вам было спокойнее', '/kontakty/': 'Заглядывайте в гости!', '/svedeniya/': '', '/privacy/': '', '/soglasie/': '' };
---
<Layout title={title} description={description} address={settings.address} phone={settings.phone}>
  <div class="inner-page">
  <PageIntro heading={heading} intro={intro} label={label} art={art || pageArt[Astro.url.pathname]} note={note ?? pageNotes[Astro.url.pathname]} mascot={mascot} parent={parent}/>
  <slot/>
  {callout && <Callout compact/>}
  </div>
</Layout>
