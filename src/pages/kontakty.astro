---
import Inner from '../layouts/Inner.astro';
import Icon from '../components/el-bebe/Icon.astro';
import { getSiteContent } from '../lib/cms';
import { siteLocation } from '../data/site-location';
const { settings } = await getSiteContent();
---
<Inner title="Контакты Эльбэби — детский сад на Виноградной в Сочи" heading="Как найти Эльбэби" label="Контакты" description={`Адрес детского сада Эльбэби: ${settings.address}. Контакты, карта и запись на экскурсию.`} intro="Покажем сад, познакомим с воспитателями и ответим на вопросы. Договоримся о встрече заранее, чтобы уделить вам время.">
  <section class="container content-section contact-panel"><div><h2>Эльбэби в Сочи</h2><p>{settings.address}{settings.address === siteLocation.address && <><br/>{siteLocation.floor}</>}<br/>Центральный район</p><div class="contact-actions"><button type="button" class="button" data-open-visit>Записаться на знакомство <Icon name="arrow" size={20}/></button>{settings.phone && <a href={`tel:${settings.phone.replace(/[^+\d]/g,'')}`}>{settings.phone}</a>}</div><p class="contact-hint">Маршрут и расположение входа уточним перед визитом.</p></div><a class="map-card contact-map" href="https://yandex.ru/maps/org/el_bebe/154599785417/" target="_blank" rel="noopener noreferrer"><div class="map-art" aria-hidden="true"><i></i><i></i><i></i></div><span><Icon name="pin" size={46}/><b>Эльбэби<br/>Сочи</b><Icon name="arrow"/></span></a></section>
  <section class="container content-section editorial"><h2>Где посмотреть отзывы</h2><p>Садик есть на <a href="https://yandex.ru/maps/org/el_bebe/154599785417/" target="_blank" rel="noopener noreferrer">Яндекс Картах</a> и в <a href="https://2gis.ru/sochi/firm/70000001044912349" target="_blank" rel="noopener noreferrer">2ГИС</a>. Перед поездкой проверьте актуальные сведения в карточке или свяжитесь с нами.</p></section>
</Inner>
