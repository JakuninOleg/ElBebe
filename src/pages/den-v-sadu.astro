---
import Inner from '../layouts/Inner.astro';
import Puzzle from '../components/el-bebe/Puzzle.astro';
import { daySteps } from '../data/el-bebe';
import { dailySchedule } from '../data/daily-schedule';
import Included from '../components/el-bebe/Included.astro';
import Faq from '../components/el-bebe/Faq.astro';
const questions = [
  { question: 'Сколько приёмов пищи на полном дне?', answer: 'На полном дне в детском саду — четыре приёма пищи: завтрак, обед, полдник и ужин. Питание включено в стоимость. Актуальное меню обсудим до начала посещений; если у ребёнка есть аллергия или пищевые ограничения, обязательно расскажите о них заранее.' },
  { question: 'Расписание занятий одинаковое у всех групп?', answer: 'Нет. Младшая, средняя и старшая группы занимаются по разным программам. В средней есть английский язык и азбука, в старшей — подготовка к школе, робототехника и шахматы. На странице каждой группы опубликовано отдельное расписание на пять дней недели.', link: { href: '/gruppy/', label: 'Выбрать группу' } },
  { question: 'Можно ли оставаться в саду после 19:00?', answer: 'Эльбэби работает 24/7. Полный день в прайсе — до 19:00, ночное пребывание — отдельный режим с 19:00 до 09:00. Даты, часы и наличие мест согласуем при записи.', link: { href: '/stoimost/', label: 'Стоимость и режимы' } },
];
---
<Inner title="Распорядок дня в детском саду Эльбэби — Сочи" heading="Как проходит день в Эльбэби" label="День в саду" description="Распорядок дня детского сада Эльбэби в Сочи: встреча с 8:00, занятия, прогулки, питание, дневной сон и свободная игра." intro="В течение дня чередуем занятия, прогулки, питание и отдых. Посмотрите распорядок сада — он поможет представить день ребёнка и подготовиться к первым посещениям.">
  <div class="container content-section"><Included/></div>
  <section class="container content-section"><h2>Время для всего важного</h2><div class="day-page-list">{daySteps.map((item,i) => <article><Puzzle color={item.color} icon={item.icon}/><div><h3>{item.title}</h3><p>{[ 'Начинаем с приветствия. Можно освоиться, выбрать игру и пообщаться с воспитателем.', 'Рисуем, строим, разговариваем и исследуем. Чередуем занятия и свободную игру.', 'Делаем паузу, обедаем и восстанавливаем силы. Обсуждаем привычки и особенности питания с родителями.', 'Двигаемся, играем и наблюдаем за миром. Порядок прогулок зависит от погоды и режима группы.', 'Делимся впечатлениями дня. Воспитатель расскажет, что было интересно ребёнку и как он себя чувствовал.' ][i]}</p></div></article>)}</div></section>
  <section class="container content-section editorial" id="raspisanie"><h2>Распорядок дня</h2><p>Общие события дня для всех групп. Точное время и занятия по дням недели смотрите в <a href="/gruppy/#weekly-title">расписаниях младшей, средней и старшей групп</a>.</p><dl class="daily-schedule">{dailySchedule.map(([time, activity]) => <div><dt>{time}</dt><dd>{activity}</dd></div>)}</dl></section>
  <section class="container content-section editorial"><h2>Питание и дневной отдых</h2><p>В стоимость полного дня включены четыре приёма пищи: завтрак, обед, полдник и ужин. После обеда — сон или тихие игры. Актуальное меню и питание для выбранного режима обсудим при знакомстве. Об аллергии и пищевых ограничениях важно рассказать до начала посещений.</p><p><a href="/gruppy/#rezhimy">Выбрать режим посещения</a> · <a href="/stoimost/">Посмотреть стоимость</a></p></section>
  <section class="container content-section group-detail-faq"><h2>О распорядке и питании</h2><Faq items={questions}/></section>
</Inner>
