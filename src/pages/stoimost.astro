---
import Inner from '../layouts/Inner.astro';
import Icon from '../components/el-bebe/Icon.astro';
import AttendanceRates from '../components/el-bebe/AttendanceRates.astro';
import { getSiteContent } from '../lib/cms';
const { rates } = await getSiteContent();
---
<Inner title="Стоимость частного детского сада в Сочи — Эльбебе" heading="Стоимость посещения Эльбебе" label="Стоимость" description="Режимы посещения Эльбебе, состав оплаты и возможность использовать материнский капитал." intro="Подберём режим, который подходит вашей семье. До начала посещений обсудим стоимость, питание, занятия и условия договора.">
  <AttendanceRates rates={rates} heading="Режимы посещения" showDetailsLink={false}/>
  <section class="container content-section editorial"><h2>Что обсудим перед зачислением</h2><ul><li>Подходящую группу, свободные места и время посещения.</li><li>Что входит в оплату: присмотр, питание, занятия и другие услуги по договору.</li><li>Порядок оплаты и условия перерасчёта при пропусках.</li><li>Документы и подготовку к первым дням в саду.</li></ul><p>Актуальные суммы и состав услуг указываются в договоре. На знакомстве можно спокойно задать все вопросы до принятия решения.</p></section>
  <section class="container content-section editorial" id="matkapital"><h2>Оплата материнским капиталом</h2><p>У Эльбебе есть образовательная лицензия. Посещение сада можно оплатить средствами материнского капитала при соблюдении условий программы.</p><ol><li><strong>Обсуждаем услуги и договор.</strong> Уточняем, какие услуги доступны к оплате материнским капиталом, стоимость и порядок перечисления.</li><li><strong>Готовим документы.</strong> Родитель заключает договор и подаёт заявление о распоряжении средствами в Социальный фонд России.</li><li><strong>Ждём решения СФР.</strong> Фонд проверяет заявление и документы. При одобрении средства перечисляются исполнителю по установленным правилам.</li></ol><p>Возможность оплаты конкретных услуг зависит от договора и сведений в реестре лицензий. Одобрение заявления принимает СФР; сад не может гарантировать решение фонда.</p><p><a href="/svedeniya/#documents">Лицензия и документы сада</a></p><button type="button" class="button" data-open-visit>Обсудить оплату <Icon name="arrow" size={20}/></button></section>
</Inner>
