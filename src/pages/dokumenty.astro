---
import Inner from '../layouts/Inner.astro';
import Icon from '../components/el-bebe/Icon.astro';
import OperatorDetails from '../components/el-bebe/OperatorDetails.astro';
const documents = [
  { href: '/svedeniya/', title: 'Сведения о саде', text: 'Исполнитель, реквизиты ИП и информация о документах для родителей.', icon: 'document', color: 'mint' },
  { href: '/privacy/', title: 'Политика обработки данных', text: 'Какие данные используются, для чего они нужны и как обратиться к оператору.', icon: 'shield', color: 'blue' },
  { href: '/soglasie/', title: 'Согласие на обработку данных', text: 'Отдельное согласие для обращения и записи на знакомство с садом.', icon: 'heart', color: 'pink' },
  { href: '/cookies/', title: 'Cookie и внешние сервисы', text: 'Как работает карта Яндекса и как изменить свой выбор.', icon: 'pin', color: 'yellow' },
];
---
<Inner title="Документы и персональные данные — Эльбэби" heading="Документы и сведения о саде" label="Документы" description="Сведения об ИП Семенюк Юлии Андреевне, документы детского сада Эльбэби и информация о персональных данных." intro="Здесь собраны реквизиты сада, информация о лицензии и договоре, а также правила обработки персональных данных." callout={false} art="document" note="">
  <section class="container content-section legal-folder" aria-labelledby="documents-heading"><h2 id="documents-heading">Документы для родителей</h2><div class="legal-directory">{documents.map(document => <a class:list={['legal-document-link', `legal-document-link--${document.color}`]} href={document.href}><span class="legal-document-icon"><Icon name={document.icon} size={48}/></span><div><h3>{document.title}</h3><p>{document.text}</p></div><span class="legal-document-arrow"><span>Открыть</span><Icon name="arrow" size={24}/></span></a>)}</div></section>
  <section class="container content-section legal-operator-block" aria-labelledby="operator-heading"><div><h2 id="operator-heading">Кто отвечает за сад</h2><p>Адрес регистрации ИП отличается от адреса садика. На экскурсию ждём вас на Виноградной, 2/3 в Сочи.</p><a class="text-link" href="/kontakty/">Как нас найти <Icon name="arrow" size={20}/></a></div><OperatorDetails/></section>
  <section class="container content-section legal-next" aria-labelledby="parent-documents-heading"><h2 id="parent-documents-heading">Перед началом посещения</h2><p>Ознакомьтесь с лицензией, договором и условиями выбранного режима посещения. <a href="/svedeniya/#documents">Информация о документах</a> собрана отдельно. Стоимость опубликована в разделе <a href="/stoimost/">«Стоимость»</a>.</p></section>
</Inner>
