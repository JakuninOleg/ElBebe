---
import Layout from '../layouts/ElBebe.astro';
import Icon from '../components/el-bebe/Icon.astro';
import Puzzle from '../components/el-bebe/Puzzle.astro';
import Sprig from '../components/el-bebe/Sprig.astro';
import Decor from '../components/el-bebe/Decor.astro';
import Wave from '../components/el-bebe/Wave.astro';
import Faq from '../components/el-bebe/Faq.astro';
import Gallery from '../components/el-bebe/Gallery.astro';
import Callout from '../components/el-bebe/Callout.astro';
import ParentReviews from '../components/el-bebe/ParentReviews.astro';
import Surveillance from '../components/el-bebe/Surveillance.astro';
import Educators from '../components/el-bebe/Educators.astro';
import FamilyCapital from '../components/el-bebe/FamilyCapital.astro';
import HeroValueArt from '../components/el-bebe/HeroValueArt.astro';
import HeroFactIcon from '../components/el-bebe/HeroFactIcon.astro';
import AttendanceRates from '../components/el-bebe/AttendanceRates.astro';
import Groups from '../components/el-bebe/Groups.astro';
import VisitJourney from '../components/el-bebe/VisitJourney.astro';
import FirstDays from '../components/el-bebe/FirstDays.astro';
import IllustratedIcon from '../components/el-bebe/IllustratedIcon.astro';
import { getParentQuestions } from '../lib/parent-questions';
import { getSiteContent } from '../lib/cms';
import { activities, daySteps, previewSpaces } from '../data/el-bebe';
import { responsiveImage, responsiveAvif } from '../lib/responsive-image';
const content = await getSiteContent();
const { settings, rates, team, groups } = content;
const heroAddress = settings.address.replace(/^Сочи,\s*/, '');
const hasReferenceHeadline = settings.hero_title === 'Здесь детство идёт своим ходом';
const showIntroSections = false;
const spaces = content.spaces.some(s => s.image) ? content.spaces : previewSpaces;
const faqs = getParentQuestions(content.faqs).slice(0, 8);
---
<Layout title="Частный детский сад Эльбэби в Сочи — лицензия" description={`Частный детский садик с образовательной лицензией. ${settings.address}. ${settings.hours}. Онлайн-камеры для родителей. Питание и занятия включены в стоимость.`} contacts={settings}>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" imagesrcset={responsiveAvif('/images/el-bebe/real-hero-mobile-v3.webp').srcset} imagesizes="100vw" media="(max-width: 760px)" fetchpriority="high"/>
    <link rel="preload" as="image" type="image/avif" imagesrcset={responsiveAvif('/images/el-bebe/real-outdoor-play-v1.webp').srcset} imagesizes="(max-width: 1100px) 50vw, 580px" media="(min-width: 761px)" fetchpriority="high"/>
  </Fragment>
  <div class="home-page">
    <section class="hero container" aria-labelledby="hero-title">
      <span class="hero-note hand-note" aria-hidden="true">Большие<br/>открытия<br/>начинаются здесь ♡</span>
      <div class="hero-copy">
        <h1 class="hero-service" id="hero-title">Частный детский садик с образовательной лицензией в Сочи</h1>
        <p class:list={['hero-title', { 'hero-title--reference': hasReferenceHeadline }]}>{hasReferenceHeadline ? <><span class="hero-title-first">Здесь детство</span>{' '}<span class="hero-title-last">идёт своим ходом</span></> : settings.hero_title}<svg class="hero-title-heart" viewBox="0 0 100 100" aria-hidden="true"><path d="M29 83C10 59 4 24 23 20C35 17 42 31 43 47C57 11 79 22 75 39C71 58 45 79 29 91Z" fill="#ffce1c"/><path d="M30 65C21 48 19 32 25 31C31 31 31 56 37 58C43 60 57 32 63 36C69 42 47 63 30 76Z" fill="#ffe879"/><path d="M77 19C76 0 91-3 88 9S77 30 77 19ZM84 41C94 25 106 34 96 41S78 50 84 41Z" fill="#ffcf22"/></svg></p>
        <p class="hero-description">{settings.hero_text.split(/(?<=\.)\s+/).map(sentence => <span>{sentence}{' '}</span>)}<Decor kind="drops" class="hero-rays"/></p>
        <button type="button" class="button hero-visit-button" data-open-visit>Прийти познакомиться <Icon name="arrow" size={23}/><svg class="hero-cta-rays" viewBox="0 0 100 100" fill="#ffce1d" aria-hidden="true"><path d="M15 58C3 18 8 0 20 6S28 31 15 58ZM40 75C45 37 76 13 80 29S67 58 40 75ZM56 89C75 67 104 70 98 84S75 96 56 89Z"/></svg></button>
        <div class="hero-details">
        <div class="hero-facts">
          <p class="hero-location"><HeroFactIcon kind="location"/><span class="hero-fact-copy"><strong>Сочи</strong><small>{heroAddress}</small></span></p>
          {settings.license_text && <a class="hero-license" href="/stoimost/#matkapital"><HeroFactIcon kind="license"/><span class="hero-fact-copy"><strong>Есть лицензия</strong><small>Оплата маткапиталом</small></span></a>}
        </div>
        </div>
      </div>
      <div class="hero-collage">
        <div class="hero-photo"><picture><source type="image/avif" media="(max-width: 760px)" {...responsiveAvif('/images/el-bebe/real-hero-mobile-v3.webp', '100vw')} width="1100" height="1000"/><source media="(max-width: 760px)" {...responsiveImage('/images/el-bebe/real-hero-mobile-v3.webp', '100vw')} width="1100" height="1000"/><source type="image/avif" media="(min-width: 761px)" {...responsiveAvif('/images/el-bebe/real-outdoor-play-v1.webp', '(max-width: 1100px) 50vw, 580px')}/><img src="/images/el-bebe/real-outdoor-play-v1.webp" {...responsiveImage('/images/el-bebe/real-outdoor-play-v1.webp', '(max-width: 1100px) 50vw, 580px')} alt="Улыбка на прогулке" width="720" height="1280" fetchpriority="high"/></picture></div>
        <div class="hero-circle hero-circle--teacher"><img src="/images/el-bebe/real-hero-blocks-square-v1.webp" {...responsiveImage('/images/el-bebe/real-hero-blocks-square-v1.webp', '260px')} alt="Девочка играет с цветным конструктором" width="841" height="841" loading="lazy"/></div>
        <div class="hero-circle hero-circle--garden"><img src="/images/el-bebe/real-hero-rope-square-v1.webp" {...responsiveImage('/images/el-bebe/real-hero-rope-square-v1.webp', '260px')} alt="Мальчик на верёвочном мостике" width="720" height="720" loading="lazy"/></div>
        <span class="collage-note hand-note" aria-hidden="true"><span class="desktop-text">Любопытные<br/>дети —<br/>счастливые<br/>люди ♡</span><span class="mobile-text">Счастливые<br/>дети ♡</span></span>
        <Sprig class="hero-sprig"/>
      </div>
      <ul class="hero-values"><li><HeroValueArt kind="heart"/><span>Забота<br/>каждый день</span></li><li><HeroValueArt kind="blocks"/><span>Развитие<br/>через игру</span></li><li><IllustratedIcon name="clock" class="hero-value-art"/><span>{settings.hours}</span></li></ul>
      <Decor kind="wash" color="#ffdde8" class="hero-pink-wash"/>
      <Decor kind="wash" color="#c7ebe6" class="hero-side-wash"/>
    </section>

    {showIntroSections && <><section class="activities section container" aria-labelledby="activities-title">
      <svg class="hero-next-wave" viewBox="0 0 390 91" preserveAspectRatio="none" aria-hidden="true"><path d="M0 16C30-4 49 7 77 12S119 15 143 7S178 0 211 12S270 31 314 21S357 12 372 4S386 0 390 4V91H0Z"/></svg>
      <div class="section-heading"><h2 id="activities-title"><span class="desktop-text">Разностороннее развитие каждый день</span><span class="mobile-text">Развиваем важные навыки</span></h2><a class="text-link" href="/gruppy/">Все направления <Icon name="arrow" size={20}/></a></div>
      <div class="activity-grid">{activities.map((item,i) => <a class="activity" href={`/gruppy/#${['tvorchestvo','rech','logika','dvizhenie','progulki','navyki'][i]}`}><div class="activity-photo"><img src={`/images/el-bebe/${item.image}.webp`} alt="" width="500" height="500" loading="lazy"/><Puzzle color={item.color}/></div><h3>{item.title}</h3><p>{item.text}</p></a>)}</div>
      <Decor kind="wash" color="#ffdedf" class="activities-wash"/>
      <Decor kind="heart" color="#ffb4bd" class="activities-heart"/>
      <Decor kind="drops" color="#91d9eb" class="activities-drops"/>
    </section>

    <section class="about section container" id="about-intro" aria-labelledby="about-title">
      <div class="about-image"><img src="/images/el-bebe/real-friends-square-v1.webp" alt="Дети дружат и играют вместе" width="1400" height="933" loading="lazy"/><span class="about-note hand-note" aria-hidden="true">Как хорошо<br/>играть<br/>вместе ♡</span><Decor kind="drops" class="about-drops"/></div>
      <div class="about-copy"><h2 id="about-title">Больше, чем просто сад</h2><p class="lead">Детство — время для игры, открытий и настоящих отношений. В Эльбэби мы знакомимся с миром в своём темпе: пробуем новое, учимся дружить и быть собой.</p><div class="about-points">{[{ icon: 'heart', title: 'Игра', text: 'Пробуем новое и находим свои интересы.', color: '#ff6476' }, { icon: 'people', title: 'Общение', text: 'Учимся дружить и слушать друг друга.', color: '#ffca36' }, { icon: 'leaf', title: 'Забота', text: 'Видим интересы ребёнка и помогаем.', color: '#26abe0' }].map(item => <div class="about-point"><Puzzle color={item.color} icon={item.icon}/><div><h3>{item.title}</h3><p>{item.text}</p></div></div>)}</div></div>
      <Sprig class="about-sprig"/>
      <Decor kind="drops" color="#ffa9b4" class="about-pink-drops"/>
      <Decor kind="wash" color="#ffdde2" class="about-side-wash"/>
    </section>

    </>}

    <Groups groups={groups}/>
    <AttendanceRates rates={rates} heading="Режимы и стоимость"/>

    <section class="day-band" aria-labelledby="day-title">
      <Wave/>
      <div class="container"><div class="day-intro"><h2 id="day-title">День в Эльбэби</h2><p>Есть время для всего важного:<br/>игры, занятий, отдыха и новых впечатлений.</p></div><ol class="day-steps">{daySteps.map(item => <li><Puzzle color={item.color} icon={item.icon}/><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}</ol><span class="day-note hand-note" aria-hidden="true">Каждый день<br/>особенный ♡</span><a class="day-details text-link" href="/den-v-sadu/">Как проходит день <Icon name="arrow" size={19}/></a></div>
      <Decor kind="heart" color="#ffabb2" class="day-heart-art"/>
      <Decor kind="drops" class="day-drops-left"/>
      <Decor kind="drops" class="day-drops-right"/>
    </section>

    <FirstDays/>

    <Surveillance/>

    <section class="spaces section container" aria-labelledby="spaces-title"><div class="section-heading"><h2 id="spaces-title">Жизнь в Эльбэби</h2><p>Занятия, прогулки<br/>и счастливые моменты.</p><a class="text-link" href="/prostranstvo/">Смотреть все фото <Icon name="arrow" size={20}/></a></div><Gallery items={spaces.slice(0,4)}/><Decor kind="wash" color="#c7eaf4" class="spaces-side-wash"/></section>

    <Educators team={team} usePreview={!content.teamConfigured}/>

    <VisitJourney/>

    <FamilyCapital/>

    <section class="questions section container" aria-labelledby="questions-title"><div class="section-heading"><h2 id="questions-title">Частые вопросы родителей</h2><a href="/roditelyam/" class="text-link">Все вопросы <Icon name="arrow" size={20}/></a></div><Faq items={faqs}/><Decor kind="wash" color="#c9eaf5" class="faq-side-wash"/><Decor kind="drops" class="faq-drops"/></section>
    <ParentReviews testimonials={content.testimonials}/>
    <Callout/>
  </div>
</Layout>
