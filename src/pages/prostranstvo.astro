---
import Inner from '../layouts/Inner.astro';
import Gallery from '../components/el-bebe/Gallery.astro';
import { getSiteContent } from '../lib/cms';
import { previewSpaces } from '../data/el-bebe';
const { spaces } = await getSiteContent();
---
<Inner title="Фотографии и пространство детского сада Эльбебе в Сочи" heading="Пространство детского сада" label="Пространство" description="Пространство Эльбебе для игр, занятий и отдыха. Приходите познакомиться с садиком на Виноградной в Сочи." intro="Садик лучше увидеть своими глазами. Приходите в гости: покажем пространство и поговорим о том, как устроен день ребёнка.">
  <section class="container content-section"><Gallery items={spaces.some(s=>s.image) ? spaces : previewSpaces} full/><p class="gallery-caption">Временные сгенерированные изображения для макета. Это не фотографии помещений и территории Эльбебе.</p></section>
</Inner>
