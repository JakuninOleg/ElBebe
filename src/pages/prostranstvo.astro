---
import Inner from '../layouts/Inner.astro';
import Gallery from '../components/el-bebe/Gallery.astro';
import { getSiteContent } from '../lib/cms';
import { previewSpaces } from '../data/el-bebe';
import Faq from '../components/el-bebe/Faq.astro';
const questions = [
  { question: 'Можно ли увидеть сад до зачисления?', answer: 'Да. На знакомстве покажем пространство для игр, занятий и отдыха, познакомимся с воспитателями и обсудим жизнь группы. Согласуем время заранее, чтобы спокойно ответить на ваши вопросы.' },
  { question: 'Есть ли онлайн-камеры для родителей?', answer: 'Да, в Эльбэби есть видеонаблюдение онлайн для родителей. Как получить доступ к трансляции и пользоваться ею, расскажем при знакомстве с садом.' },
  { question: 'Где находится детский сад?', answer: 'Эльбэби находится в Сочи, на улице Виноградной, 2/3, на первом этаже. Перед визитом уточним маршрут и расположение входа.', link: { href: '/kontakty/', label: 'Контакты и карта' } },
];
const { spaces } = await getSiteContent();
---
<Inner title="Фотографии жизни детского сада Эльбэби в Сочи" heading="Жизнь в Эльбэби" label="Фотографии" description="Фотографии детей, занятий, прогулок и праздников в Эльбэби. Моменты из жизни детского сада в Сочи." intro="Играем, занимаемся, гуляем и празднуем вместе. Сохраняем моменты, из которых складывается детство.">
  <section class="container content-section"><Gallery items={spaces.some(s=>s.image) ? spaces : previewSpaces} full/></section>
  <section class="container content-section group-detail-faq"><h2>Перед визитом в сад</h2><Faq items={questions}/></section>
</Inner>
