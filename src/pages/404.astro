---
import Layout from '../layouts/ElBebe.astro';
import Callout from '../components/el-bebe/Callout.astro';
import Decor from '../components/el-bebe/Decor.astro';
import Sprig from '../components/el-bebe/Sprig.astro';
import Icon from '../components/el-bebe/Icon.astro';
import IllustratedIcon from '../components/el-bebe/IllustratedIcon.astro';
Astro.response.status = 404;
---
<Layout title="Страница не найдена — Эльбэби" description="Такой страницы нет. Вернитесь на главную сайта детского сада Эльбэби или свяжитесь с нами.">
  <div class="not-found-page">
    <section class="not-found-hero container" aria-labelledby="not-found-title">
      <div class="not-found-art" aria-hidden="true"><Decor kind="wash" color="#e0eee2" class="not-found-wash"/><div class="not-found-digits"><span>4</span><span>0</span><span>4</span></div><img src="/images/el-bebe/bunny-guide.webp" alt="" width="414" height="640" fetchpriority="high"/><IllustratedIcon name="sun" class="not-found-sun" size={70}/><Sprig class="not-found-sprig"/><Decor kind="drops" class="not-found-drops"/><svg class="not-found-trail" viewBox="0 0 520 110" fill="none"><path d="M12 59C73 106 141 10 205 41S302 99 361 68S434 7 500 35" stroke="#72a5a6" stroke-width="3" stroke-linecap="round" stroke-dasharray="7 10"/><path d="m488 21 14 14-18 7" stroke="#72a5a6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
      <div class="not-found-copy"><p class="not-found-status">Страница не найдена · 404</p><h1 id="not-found-title">Кажется, мы свернули не туда</h1><p>Такой страницы нет или её адрес изменился. Перейдите на главную или выберите нужный раздел ниже.</p><div class="not-found-actions"><a href="/" class="button">На главную <Icon name="arrow" size={22}/></a><a href="/gruppy/" class="text-link">Посмотреть группы <Icon name="arrow" size={20}/></a></div></div>
    </section>
    <nav class="container not-found-shortcuts" aria-label="Полезные разделы"><a href="/den-v-sadu/"><IllustratedIcon name="sun" size={44}/><span>Как проходит день</span><Icon name="arrow" size={20}/></a><a href="/stoimost/"><IllustratedIcon name="clock" size={44}/><span>Режимы и стоимость</span><Icon name="arrow" size={20}/></a><a href="/kontakty/"><IllustratedIcon name="pin" size={44}/><span>Как нас найти</span><Icon name="arrow" size={20}/></a></nav>
    <Callout compact/>
  </div>
</Layout>
