---
import Inner from '../layouts/Inner.astro';
import { getSiteContent } from '../lib/cms';
import { Image } from '../lib/emdash-ui';
const { team } = await getSiteContent();
---
<Inner title="Воспитатели детского сада Эльбебе в Сочи" heading="Наши воспитатели" label="Воспитатели" description="Знакомство с воспитателями Эльбебе: команда, подход к детям и общение с родителями." intro="Для ребёнка воспитатель — человек, к которому можно подойти с вопросом, радостью или тревогой. Для родителя — тот, с кем можно обсудить, как проходит день.">
  {team.length > 0 ? <section class="container content-section"><div class="content-grid">{team.map(person => <article class="team-card">{person.image && <Image image={person.image} alt={person.name} width={600} height={600}/>}<h3>{person.name}</h3><p class="role">{person.role}</p><p>{person.bio}</p></article>)}</div></section> : <section class="container content-section editorial"><h2>Познакомимся лично</h2><p>Приходите на экскурсию: познакомимся с воспитателями, поговорим о привычках ребёнка и о том, что для вашей семьи важно в садике.</p><p>Фотографии и рассказы о команде появятся здесь после подготовки материалов сада.</p></section>}
  <section class="container content-section"><div class="content-grid"><article class="content-card"><h3>Замечать</h3><p>Интересы, настроение и маленькие успехи каждого ребёнка.</p></article><article class="content-card"><h3>Поддерживать</h3><p>Помогать пробовать, договариваться и справляться с трудностями.</p></article><article class="content-card"><h3>Быть на связи</h3><p>Обсуждать с родителями день ребёнка и важные для него перемены.</p></article></div></section>
</Inner>
