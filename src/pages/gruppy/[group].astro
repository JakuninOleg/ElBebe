---
import GroupDetail from '../../components/el-bebe/GroupDetail.astro';
import { groupPages } from '../../data/group-pages';
export const prerender = true;
export function getStaticPaths() {
  return Object.entries(groupPages).map(([groupId, page]) => ({ params: { group: page.slug }, props: { groupId } }));
}
const { groupId } = Astro.props;
---
<GroupDetail groupId={groupId}/>
