---
import GroupDetail from '../../components/el-bebe/GroupDetail.astro';
import { groupPages } from '../../data/group-pages';
export const prerender = false;
const group = Object.entries(groupPages).find(([, page]) => page.slug === Astro.params.group);
if (!group) return Astro.rewrite('/404');
const [groupId] = group;
---
<GroupDetail groupId={groupId}/>
