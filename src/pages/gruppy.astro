---
import Inner from '../layouts/Inner.astro';
import Groups from '../components/el-bebe/Groups.astro';
import FirstDays from '../components/el-bebe/FirstDays.astro';
import Included from '../components/el-bebe/Included.astro';
import Faq from '../components/el-bebe/Faq.astro';
import { getSiteContent } from '../lib/cms';
import ScheduleLinks from '../components/el-bebe/ScheduleLinks.astro';
import VisitModes from '../components/el-bebe/VisitModes.astro';
const { groups, rates, settings } = await getSiteContent();
const questions = [
  { question: 'Чем отличаются младшая, средняя и старшая группы?', answer: 'У каждой группы своя программа. В младшей — развитие речи, сенсорика, Монтессори, музыка и первые задачи с кубиками. В средней добавляются английский язык, азбука, хореография и практические занятия. В старшей — подготовка к школе, робототехника, нейроигры, шахматы и финансовая грамотность. На страницах групп можно посмотреть полный перечень и недельное расписание.' },
  { question: 'Все ли занятия входят в стоимость?', answer: 'Да. Все занятия по программе группы и питание в часы посещения включены в стоимость детского сада. В стоимость полного дня входят четыре приёма пищи: завтрак, обед, полдник и ужин. Вступительный взнос указан отдельно в прайсе.', link: { href: '/stoimost/', label: 'Посмотреть цены' } },
  { question: 'Можно ли посещать сад неполный день или ночью?', answer: 'Режим работы указан в контактах сада. Есть полный и неполный день, почасовое и разовое посещение, выходные дни и ночное пребывание. Для ночи и выходного дня в прайсе предусмотрены отдельные режимы. Перед началом согласуем время посещения, свободные места и условия договора.' },
];
---
<Inner title="Группы детского сада Эльбэби в Сочи — занятия и расписание" heading="Наши группы" label="Наши группы" description="Младшая, средняя и старшая группы Эльбэби в Сочи. Логопед, английский, робототехника, шахматы и подготовка к школе. Питание и занятия включены." intro="Посмотрите занятия и расписание младшей, средней и старшей групп. На встрече поможем выбрать группу и режим посещения." mascot note="Найдём вашу группу">
  <Groups groups={groups} headingLevel="h1" showHeading={false}/>
  <div class="container content-section"><Included/></div>
  <ScheduleLinks/>
  <VisitModes rates={rates} hours={settings.hours}/>
  <div id="adaptaciya"><FirstDays/></div>
  <section class="container content-section group-detail-faq"><h2>Как выбрать группу</h2><Faq items={questions}/></section>
</Inner>
