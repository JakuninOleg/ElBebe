---
import Icon from './Icon.astro';
import IllustratedIcon from './IllustratedIcon.astro';
import ExternalMap from './ExternalMap.astro';
import MessengerIcon from './MessengerIcon.astro';
import type { SiteContacts } from '../../data/site-contacts';
interface Props { contacts: SiteContacts; }
const { contacts } = Astro.props;
const { address, phone: contactPhone, phoneHref } = contacts;
const sections = [
  { title: 'О саде', links: [['Знакомство с садом', '/#o-sade'], ['Воспитатели', '/komanda/'], ['Галерея', '/prostranstvo/']] },
  { title: 'Наши группы', links: [['Все группы', '/gruppy/'], ['Младшая группа', '/gruppy/mladshaya/'], ['Средняя группа', '/gruppy/srednyaya/'], ['Старшая группа', '/gruppy/starshaya/']] },
  { title: 'Родителям', links: [['Стоимость', '/stoimost/'], ['День в саду', '/den-v-sadu/'], ['Вопросы родителей', '/roditelyam/'], ['Документы', '/dokumenty/'], ['Контакты', '/kontakty/']] },
];
---
<footer class="site-footer" id="kontakty">
  <section class="footer-location container" aria-labelledby="footer-location-title">
    <div class="footer-location-copy">
      <h2 id="footer-location-title">Приходите<br/>знакомиться</h2>
      <p>Покажем садик, ответим на вопросы<br class="footer-copy-break"/> и расскажем о нашей жизни.</p>
      <dl class="footer-location-facts">
        <div><dt><IllustratedIcon name="pin" size={44}/>Наш адрес</dt><dd>{address}</dd></div>
        <div><dt><IllustratedIcon name="clock" size={44}/>Режим работы</dt><dd>{contacts.hours}</dd></div>
      </dl>
      <a class="footer-phone" href={phoneHref}>{contactPhone}</a>
      <a class="footer-email" href={`mailto:${contacts.email}`}>{contacts.email}</a>
      <div class="footer-messengers" role="group" aria-label="Написать нам">{contacts.messengers.map(link=>link.href
        ? <a class={`messenger-button messenger-button--${link.id}`} href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`Написать в ${link.label}`}><MessengerIcon name={link.id}/><span>{link.label}</span></a>
        : <button class={`messenger-button messenger-button--${link.id}`} type="button" disabled aria-label={`${link.label} — скоро`} title="Ссылка появится позже"><MessengerIcon name={link.id}/><span>{link.label}</span></button>
      )}</div>
      <img class="footer-guide" src="/images/el-bebe/bunny-guide.webp" alt="" width="414" height="640" loading="lazy"/>
    </div>
    <ExternalMap class="footer-live-map" address={address}/>
  </section>
  <div class="container footer-main">
    <div class="footer-brand"><a href="/" aria-label="Эльбэби — на главную"><img src="/images/el-bebe/logo-ru-approved.svg" alt="Детский сад Эльбэби" width="1495" height="775" loading="lazy"/></a><p><span aria-hidden="true"><Icon name="heart" size={28}/></span> С любовью к детям.<br/>С заботой о будущем.</p></div>
    <nav class="footer-navigation" aria-label="Разделы сайта">{sections.map(section=><details class="footer-nav-group" open data-footer-section><summary>{section.title}<Icon name="chevron" size={18}/></summary><ul>{section.links.map(([label,href])=><li><a href={href}>{label}<Icon name="chevron" size={16}/></a></li>)}</ul></details>)}</nav>
  </div>
  <div class="container footer-bottom"><p>Эльбэби · частный детский сад в Сочи</p><nav aria-label="Документы"><a href="/dokumenty/">Документы сада</a><a href="/svedeniya/">Сведения об ИП</a><a href="/privacy/">Персональные данные</a><button type="button" data-open-privacy>Настройки cookie</button></nav></div>
</footer>
