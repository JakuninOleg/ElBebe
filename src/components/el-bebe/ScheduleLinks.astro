---
import { groupCards } from '../../data/group-cards';
import { groupPages } from '../../data/group-pages';
import IllustratedIcon from './IllustratedIcon.astro';
import Icon from './Icon.astro';
---
<section class="schedule-links container content-section" aria-labelledby="weekly-title">
  <div class="week-intro"><IllustratedIcon name="calendar" size={96}/><h2 id="weekly-title">Неделя в вашей группе</h2><p>У каждого дня свои занятия. Выберите группу и посмотрите всю неделю.</p><span class="hand-note" aria-hidden="true">С понедельника<br/>до пятницы</span></div>
  <div class="week-index">{groupCards.map((group, i) => <a class={`week-index-link week-index-link--${group.accent}`} id={`schedule-${group.id}`} href={`/gruppy/${groupPages[group.id].slug}/#weekly-title`}>
    <IllustratedIcon name={['lesson-sensory','lesson-english','lesson-robot'][i]} size={58}/><div><h3>{group.title}</h3><p>{group.summary}</p><span>Посмотреть расписание</span></div><Icon name="arrow" size={26}/>
  </a>)}</div>
</section>
