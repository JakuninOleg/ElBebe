---
import Icon from './Icon.astro';
import NavigationItems from './NavigationItems.astro';
---
<div class="header-shell">
<header class="site-header" data-scroll-header>
  <svg class="menu-blob" viewBox="0 0 130 120" preserveAspectRatio="none" aria-hidden="true"><path class="menu-blob-original" d="M0 0H130V120C115 101 95 114 66 99C28 80 41 38 0 0Z" fill="#c4eeea"/><path class="menu-blob-home" d="M0 0H130V120C63 120 5 74 0 0Z" fill="#c4eeea"/></svg>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Эльбэби — на главную"><img src="/images/el-bebe/logo-ru-approved.svg" width="1495" height="775" alt="Детский сад Эльбэби, Сочи" fetchpriority="high" /></a>
    <nav class="desktop-nav" aria-label="Основное меню"><NavigationItems prefix="desktop"/></nav>
    <button class="button header-cta" type="button" data-open-visit>Записаться на экскурсию <Icon name="arrow" size={20}/></button>
    <button class="menu-toggle" type="button" aria-label="Открыть меню" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle><Icon name="menu" class="menu-bars" size={28}/><Icon name="close" class="menu-close" size={28}/></button>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label="Меню сайта" hidden>
    <NavigationItems prefix="mobile"/>
    <button class="button" type="button" data-open-visit>Записаться на экскурсию <Icon name="arrow" size={20}/></button>
  </nav>
</header>
</div>
