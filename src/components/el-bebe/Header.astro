---
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const items = [
  { href: '/#o-sade', label: 'О саде' }, { href: '/gruppy/', label: 'Группы' },
  { href: '/stoimost/', label: 'Стоимость' }, { href: '/den-v-sadu/', label: 'День в саду' },
  { href: '/komanda/', label: 'Воспитатели' }, { href: '/kontakty/', label: 'Контакты' },
];
---
<header class="site-header">
  <svg class="menu-blob" viewBox="0 0 130 120" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H130V120C115 101 95 114 66 99C28 80 41 38 0 0Z" fill="#c4eeea"/></svg>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Эльбебе — на главную"><img src="/images/el-bebe/logo-straight-v2.webp" width="680" height="379" alt="Детский сад Эльбебе, Сочи" fetchpriority="high" /></a>
    <nav class="desktop-nav" aria-label="Основное меню">{items.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}</nav>
    <button class="button header-cta" type="button" data-open-visit>Прийти познакомиться <Icon name="arrow" size={20}/></button>
    <button class="menu-toggle" type="button" aria-label="Открыть меню" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle><Icon name="menu" class="menu-bars" size={28}/><Icon name="close" class="menu-close" size={28}/></button>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label="Мобильное меню" hidden>
    {items.map(item => <a href={item.href}>{item.label}<Icon name="chevron" size={18}/></a>)}
    <a href="/prostranstvo/">Фотографии сада<Icon name="chevron" size={18}/></a>
    <a href="/roditelyam/">Вопросы родителей<Icon name="chevron" size={18}/></a>
    <button class="button" type="button" data-open-visit>Прийти познакомиться <Icon name="arrow" size={20}/></button>
  </nav>
</header>
