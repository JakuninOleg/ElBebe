---
interface Props { kind: 'location' | 'license'; }
const { kind } = Astro.props;
---
<svg class="hero-fact-art" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
  {kind === 'location' ? <>
    <path d="M5 9C11 1 25 0 33 7S41 26 32 34S12 42 5 32S-2 17 5 9Z" fill="#ffe5e2"/>
    <path d="M20 32S10.5 23.2 10.5 16A9.5 9.5 0 0 1 29.5 16C29.5 23.2 20 32 20 32Z" fill="#f5707b"/>
    <circle cx="20" cy="16" r="3.8" fill="#fffdf7"/>
  </> : <>
    <path d="M7 5C17-2 30 2 36 11S40 30 30 36S9 40 4 29S-1 12 7 5Z" fill="#e2efdb"/>
    <path d="m20 7 10 4v8.2c0 6.3-10 13.2-10 13.2S10 25.5 10 19.2V11Z" fill="#77a681"/>
    <path d="m15.5 19.5 3.1 3.2 6-6.6" stroke="#fffdf7" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"/>
  </>}
</svg>
