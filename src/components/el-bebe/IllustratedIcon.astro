---
import { illustratedIcons, illustratedIconAliases } from '../../data/illustrated-icons';
import sprite from '../../assets/el-bebe-illustrations.svg?url';
interface Props { name: string; class?: string; size?: number; }
const { name, class: className = '', size = 40 } = Astro.props;
const requested = illustratedIconAliases[name] ?? name;
const illustration = requested in illustratedIcons ? requested : 'sparkle';
---
<svg class:list={['illustrated-icon', className]} data-illustration={illustration} width={size} height={size} viewBox="0 0 120 110" fill="none" aria-hidden="true" focusable="false"><use href={`${sprite}#${illustration}`}/></svg>
