---
import Decor from './Decor.astro';
import IllustratedIcon from './IllustratedIcon.astro';
import Sprig from './Sprig.astro';
---
<div class="legal-hero-scene" aria-hidden="true">
  <Decor kind="wash" color="#e0eee2" class="legal-hero-wash"/>
  <div class="legal-hero-sheet"><IllustratedIcon name="document" size={66}/><span></span><span></span><span></span></div>
  <img src="/images/el-bebe/bunny-guide.webp" alt="" width="414" height="640" fetchpriority="high"/>
  <Sprig class="legal-hero-sprig"/><Decor kind="drops" class="legal-hero-drops"/>
</div>
