---
import { responsiveImage } from '../../lib/responsive-image';
import Icon from './Icon.astro';
import Wave from './Wave.astro';
import Decor from './Decor.astro';
import VisitForm from './VisitForm.astro';
import VisitLoading from './VisitLoading.astro';
const { compact = false } = Astro.props;
---
<section class:list={['hello-band', 'invitation', compact && 'hello-band--compact']} aria-labelledby="hello-heading">
  <Wave kind="hello"/>
  <div class="invitation-inner container">
    <div class="invitation-intro">
      <h2 id="hello-heading">Готовы<br/>познакомиться?</h2>
      <p>Приезжайте посмотреть сад и познакомиться с воспитателями. Вместе выберем группу для ребёнка.</p>
    </div>
    <div class="invitation-letter" data-visit-panel>
      <img class="invitation-bunny" src="/images/el-bebe/bunny-invitation.svg" alt="" width="400" height="400" loading="lazy" aria-hidden="true"/>
      <span class="invitation-bunny-note hand-note" aria-hidden="true">Ждём вас<br/>в гости!</span>
      <div class="invitation-paper">
        <span class="invitation-stamp" aria-hidden="true"><Icon name="heart" size={29}/></span>
        <div class="visit-state-grid" data-visit-stack data-state="form">
        <div data-visit-content>
          <h3>Приглашение<br/>в садик</h3>
          <p class="invitation-form-intro">Оставьте номер — свяжемся с вами<br class="invitation-desktop-break"/> и выберем удобное время.</p>
          <VisitForm id="hello-visit"/>
        </div>
        <VisitLoading/>
        <div class="invitation-success" data-visit-success hidden>
          <span class="invitation-success-mark" aria-hidden="true"><Icon name="check" size={44}/></span>
          <h3 id="hello-success-title" tabindex="-1">Спасибо за заявку!</h3>
          <p>Мы получили ваше имя и телефон.</p>
        </div>
        </div>
      </div>
    </div>
    <div class="invitation-memory">
      <div class="invitation-photo"><img src="/images/el-bebe/real-invitation-ladybug-v1.webp" {...responsiveImage('/images/el-bebe/real-invitation-ladybug-v1.webp')} alt="Улыбающаяся девочка в костюме божьей коровки" width="640" height="640" loading="lazy" /></div>
      <span class="invitation-note hand-note" aria-hidden="true">Давайте<br/>дружить!</span>
      <Decor kind="drops" class="invitation-photo-drops"/>
      <Decor kind="heart" class="invitation-photo-heart"/>
    </div>
  </div>
</section>
