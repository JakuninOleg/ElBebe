---
import Icon from './Icon.astro';
import Wave from './Wave.astro';
import Decor from './Decor.astro';
const { compact = false } = Astro.props;
---
<section class:list={['hello-band', compact && 'hello-band--compact']} aria-labelledby="hello-heading">
  <Wave kind="hello"/>
  <div class="hello-photo"><img src="/images/el-bebe/hello-portrait-v2.webp" alt="Портрет ребёнка — иллюстрация для макета" width="1000" height="1000" loading="lazy" /></div>
  <div class="hello-content"><h2 id="hello-heading">Готовы познакомиться?</h2><p>Приходите в Эльбебе: покажем садик, познакомим с воспитателями и поговорим о вашем ребёнке.</p><button class="button" type="button" data-open-visit>Прийти познакомиться <Icon name="arrow" size={22}/></button></div>
  <span class="hello-note hand-note" aria-hidden="true">Хорошее детство<br/>начинается здесь ♡</span>
  <span class="hello-heart" aria-hidden="true">♥</span>
  <img class="hello-bunny" src="/images/el-bebe/bunny-v2.webp" alt="" width="460" height="480" loading="lazy"/>
  <span class="hello-greeting hand-note" aria-hidden="true">Давайте<br/>познакомимся! ♡</span>
  <Decor kind="drops" class="hello-drops"/>
</section>
