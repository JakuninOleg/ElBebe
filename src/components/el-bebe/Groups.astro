---
import { responsiveImage, responsiveAvif } from '../../lib/responsive-image';
import { imageSource } from '../../lib/image-source';
import type { SiteContent } from '../../lib/cms';
import { Image } from '../../lib/emdash-ui';
import { groupCards } from '../../data/group-cards';
import IllustratedIcon from './IllustratedIcon.astro';
import Icon from './Icon.astro';
import Decor from './Decor.astro';
import { groupPages } from '../../data/group-pages';
interface Props { groups: SiteContent['groups']; headingLevel?: 'h1' | 'h2'; showHeading?: boolean; }
const { groups = [], headingLevel = 'h2', showHeading = true } = Astro.props;
const Heading = headingLevel;
const CardHeading = headingLevel === 'h1' ? 'h2' : 'h3';
const imageDescriptions = ['Рисование цветными карандашами', 'Девочка с карандашами за творческим заданием', 'Ребёнок играет в шахматы'];
---
<section class="group-programs section container" id="gruppy" aria-labelledby={showHeading ? 'growth-title' : undefined} aria-label={showHeading ? undefined : 'Программы групп'}>
  {showHeading && <header class="programs-heading">
    <div class="programs-title">
      <svg class="programs-title-wash" viewBox="0 0 600 110" preserveAspectRatio="none" aria-hidden="true"><path d="M10 63C63 30 126 1 202 17S335 67 419 36 593 18 591 63 487 106 374 93 188 91 92 101 1 83 10 63Z" fill="#fce9f0"/></svg>
      <Decor kind="drops" class="programs-title-rays programs-title-rays--left"/>
      <Heading id="growth-title">Наши группы</Heading>
      <Decor kind="drops" class="programs-title-rays programs-title-rays--right"/>
    </div>
    <p>Английский, логопед, робототехника — у каждой группы своя программа.</p>
  </header>}
  <div class="programs-grid">{groupCards.map((program, index) => {
    const photo = groups.find(group => group.id === program.id || group.title === program.title)?.image;
    const source = imageSource(photo, `/images/el-bebe/${program.image}.webp`);
    const avif = source ? responsiveAvif(source, '(max-width: 600px) calc(100vw - 64px), (max-width: 979px) 510px, 31vw') : {};
    return <article class={`program-card program-card--${program.accent}`} id={`group-${program.id}`}>
      <div class="program-card-visual">
        <picture class="program-card-photo">
          {avif.srcset && <source type="image/avif" {...avif}/>}
          {photo ? <Image image={photo} alt={imageDescriptions[index]} width={700} height={460} sizes="(max-width: 600px) calc(100vw - 64px), (max-width: 979px) 510px, 31vw"/> : <img src={`/images/el-bebe/${program.image}.webp`} {...responsiveImage(`/images/el-bebe/${program.image}.webp`, '(max-width: 600px) calc(100vw - 64px), (max-width: 979px) 510px, 31vw')} alt={imageDescriptions[index]} width={program.id === 'younger' ? 900 : program.id === 'middle' ? 720 : 960} height={program.id === 'younger' ? 783 : program.id === 'middle' ? 626 : 835} loading="lazy"/>}
        </picture>
        <Decor kind="drops" class="program-card-rays program-card-rays--left"/>
        <Decor kind="drops" class="program-card-rays program-card-rays--right"/>
      </div>
      <div class="program-card-content">
        <CardHeading>{program.title}</CardHeading>
        <p class="program-card-summary">{program.summary}</p>
        <ul class="program-lessons">{program.lessons.map(lesson => <li><span class="program-lesson-art"><IllustratedIcon name={lesson.icon} size={48}/></span><span>{lesson.label}</span></li>)}</ul>
        <a class="program-card-link" href={`/gruppy/${groupPages[program.id].slug}/`} aria-label={`Подробнее о группе: ${program.title.toLowerCase()}`}>Подробнее о группе <Icon name="arrow" size={22}/></a>
      </div>
    </article>;
  })}</div>
</section>
