---
import IllustratedIcon from './IllustratedIcon.astro';
import Decor from './Decor.astro';
import Icon from './Icon.astro';
const principles = [
  { icon: 'lesson-sensory', title: 'От интереса — к занятию', text: 'Потрогать, построить, сравнить, спросить. Знакомим с новым через понятные ребёнку игры и действия.' },
  { icon: 'blocks', title: 'Есть место своей идее', text: 'Можно попробовать другой способ, придумать сюжет и сделать самому. Воспитатель помогает, когда это нужно.' },
  { icon: 'chat', title: 'Замечаем и обсуждаем', text: 'Как ребёнок общается, что его увлекает, где нужна поддержка. Делимся наблюдениями с родителями.' },
];
---
<section class="approach-story container section" aria-labelledby="approach-title">
  <div class="approach-story-intro"><h2 id="approach-title">Наш подход:<br/>помогать пробовать</h2><p>Программа задаёт направление. Интересы, вопросы и темп ребёнка помогают выбрать, как двигаться дальше.</p><span class="approach-story-mark" aria-hidden="true"><IllustratedIcon name="heart" size={110}/><span class="hand-note">У меня<br/>получается!</span></span><a class="text-link" href="/komanda/">Познакомиться с воспитателями <Icon name="arrow" size={20}/></a></div>
  <div class="approach-principles">{principles.map(item => <article><IllustratedIcon name={item.icon} size={72}/><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div>
  <Decor kind="wash" color="#ffead3" class="approach-story-wash"/>
</section>
