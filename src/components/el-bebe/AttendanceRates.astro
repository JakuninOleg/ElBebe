---
import { responsiveImage } from '../../lib/responsive-image';
import type { SiteContent } from '../../lib/cms';
import AttendanceIcon from './AttendanceIcon.astro';
import RatePrice from './RatePrice.astro';
import Icon from './Icon.astro';
import Decor from './Decor.astro';
import Puzzle from './Puzzle.astro';
import Included from './Included.astro';
interface Props { rates: SiteContent['rates']; heading?: string; showDetailsLink?: boolean; }
const { rates, heading = 'Группы и режимы пребывания', showDetailsLink = true } = Astro.props;
const main = rates.filter(rate => rate.isMain && !rate.isEntryFee);
const other = rates.filter(rate => !rate.isMain && !rate.isEntryFee);
const fees = rates.filter(rate => rate.isEntryFee);
const icons = ['day', 'morning', 'evening'] as const;
---
<section class="attendance-rates section container" id="rezhimy" aria-labelledby="groups-title">
  <div class="attendance-heading"><h2 id="groups-title">{heading}</h2><p>Полный день, утро или несколько часов — выберите удобный режим.</p></div>
  <Included/>
  <div class="attendance-main">
    <div class="attendance-visual">
      <div class="attendance-photo"><img src="/images/el-bebe/real-speech-v1.webp" {...responsiveImage('/images/el-bebe/real-speech-v1.webp')} alt="Девочка на занятии с буквами и картинками" width="720" height="1280" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1100px) 44vw, 560px" loading="lazy"/></div>
      <span class="attendance-note hand-note" aria-hidden="true">У каждого<br/>свой ритм ♡</span>
      <Decor kind="drops" class="attendance-rays"/>
    </div>
    {main.length > 0 && <div class="attendance-primary">{main.map((rate, index) => {
      const [title, period] = rate.title.split(' · ');
      return <article class={`attendance-mode attendance-mode--${icons[index % icons.length]}`}>
      <AttendanceIcon kind={icons[index % icons.length]}/>
      <div class="attendance-mode-copy"><h3>{title}{period && <span class="attendance-period-wide"> · {period}</span>}</h3>{rate.hours && <p class="attendance-hours">{period && <span class="attendance-period-narrow">{period.charAt(0).toUpperCase() + period.slice(1)} · </span>}{rate.hours}</p>}</div>
      <RatePrice price={rate.price}/>
      {rate.title === 'Полный день' && <p class="attendance-description">Четырёхразовое питание включено: завтрак, обед, полдник и ужин.</p>}
      {rate.description && <p class="attendance-description">{rate.description}</p>}
    </article>;
    })}</div>}
  </div>
  {other.length > 0 && <div class="attendance-other"><h3>Другие режимы посещения</h3><div class="attendance-options">{other.map(rate => <article class="attendance-option"><div><h4>{rate.title}</h4>{rate.hours && <p class="attendance-hours">{rate.hours}</p>}</div><RatePrice price={rate.price}/>{rate.description && <p class="attendance-description">{rate.description}</p>}</article>)}</div></div>}
  {fees.map(rate => <div class="attendance-fee"><Puzzle color="#ffcc27"/><p><span>{rate.title} — </span><strong>{rate.price}</strong>{rate.description && <small>{rate.description}</small>}</p></div>)}
  <div class="attendance-actions"><button class="button" type="button" data-open-visit>Подобрать режим <Icon name="arrow" size={23}/></button>{showDetailsLink && <a class="text-link" href="/stoimost/">Подробнее о стоимости <Icon name="arrow" size={21}/></a>}</div>
</section>
