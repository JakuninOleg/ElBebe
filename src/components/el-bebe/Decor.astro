---
interface Props { kind?: 'drops' | 'wash' | 'heart' | 'cloud'; color?: string; class?: string; }
const { kind = 'drops', color = '#ffd148', class: className = '' } = Astro.props;
---
<svg class:list={['page-decor', `decor-${kind}`, className]} viewBox="0 0 120 140" fill={color} aria-hidden="true" focusable="false">
