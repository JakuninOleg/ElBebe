  {kind === 'wash' && <path d="M10 20C29-2 76-7 102 17S114 61 93 80S62 116 29 130S-6 113 5 91S-8 44 10 20Z"/>}
  {kind === 'heart' && <path d="M59 119C32 96-4 69 10 37C20 13 48 21 58 40C67 11 103 11 112 37C126 73 85 101 59 119Z"/>}
  {kind === 'cloud' && <path d="M26 114C-2 115-8 83 13 68C-3 39 30 10 54 28C68-5 108 6 105 37C134 43 134 80 110 89C111 116 90 131 69 117C53 138 28 135 26 114Z"/>}
</svg>
