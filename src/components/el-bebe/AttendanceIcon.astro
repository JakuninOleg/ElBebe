---
interface Props { kind: 'day' | 'morning' | 'evening'; }
const { kind } = Astro.props;
---
<svg class="attendance-icon" width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
  {kind === 'day' ? <>
    <circle cx="32" cy="32" r="14" fill="#ffcc27"/>
    <g stroke="#ffc52a" stroke-width="4" stroke-linecap="round"><path d="M32 5v6M32 53v6M5 32h6M53 32h6M13 13l4 4M47 47l4 4M13 51l4-4M47 17l4-4"/></g>
  </> : kind === 'morning' ? <>
    <circle cx="25" cy="26" r="13" fill="#ffcc27"/>
    <g stroke="#ffc52a" stroke-width="3.5" stroke-linecap="round"><path d="M25 3v5M4 26h5M9 10l4 4M41 10l-4 4M4 42l5-3"/></g>
    <path d="M28 55H17a10 10 0 0 1 0-20 13 13 0 0 1 24-5 9 9 0 0 1 11 10 8 8 0 0 1-1 15Z" fill="#75d5e9"/>
    <path d="M28 55H17a10 10 0 0 1 0-20 13 13 0 0 1 24-5" fill="#a4e5ef"/>
  </> : <>
    <path d="M15 42a17 17 0 0 1 34 0Z" fill="#ff7c52"/>
    <g stroke="#ff9554" stroke-width="3.5" stroke-linecap="round"><path d="M32 9v6M12 20l4 4M52 20l-4 4M5 39h5M54 39h5"/></g>
    <path d="M11 45h42" stroke="#ff8278" stroke-width="4" stroke-linecap="round"/>
    <path d="M17 53h30" stroke="#ff93b6" stroke-width="4" stroke-linecap="round"/>
  </>}
</svg>
