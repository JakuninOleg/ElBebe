---
import type { SiteContent } from '../../lib/cms';
import IllustratedIcon from './IllustratedIcon.astro';
import Icon from './Icon.astro';
interface Props { rates: SiteContent['rates']; }
const { rates } = Astro.props;
const modes = rates.filter(rate => !rate.isEntryFee);
const night = (title: string) => /ноч/i.test(title);
const regular = (title: string) => /полный день|неполный день/i.test(title);
const chapters = [
  { title: 'В привычном ритме', art: 'sun', rates: modes.filter(rate => regular(rate.title) && !night(rate.title)) },
  { title: 'Когда вам нужно', art: 'calendar', rates: modes.filter(rate => !regular(rate.title) && !night(rate.title)) },
  { title: 'С ночёвкой', art: 'moon', rates: modes.filter(rate => night(rate.title)) },
];
---
<section class="visit-modes container content-section" id="rezhimy" aria-labelledby="modes-title">
  <header class="visit-modes-heading"><IllustratedIcon name="clock" size={86}/><div><h2 id="modes-title">Сад под ваш ритм</h2><p>Работаем 24/7. Можно выбрать полный день, несколько часов, выходной или ночное пребывание.</p></div></header>
  <div class="visit-mode-groups">{chapters.map((chapter, i) => <article class:list={['visit-mode-group', {'visit-mode-group--night': i === 2}]}><header><IllustratedIcon name={chapter.art} size={64}/><h3>{chapter.title}</h3></header><dl>{chapter.rates.map(rate => <div><dt>{rate.title.replace(' · ', ': ')}</dt><dd>{rate.hours || 'Время согласуем при записи'}</dd></div>)}</dl>{i === 2 && <div class="night-mascot" aria-hidden="true"><img src="/images/el-bebe/bunny-approved.svg" width="100" height="140" loading="lazy" alt=""/><span class="hand-note">И вечером<br/>мы рядом</span></div>}</article>)}</div>
  <footer><a class="text-link" href="/stoimost/">Сравнить режимы и цены <Icon name="arrow" size={21}/></a></footer>
</section>
