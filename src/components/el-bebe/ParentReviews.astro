---
import { parentReviews, yandexReviewsUrl, gisReviewsUrl } from '../../data/parent-reviews';
import { selectParentReviews } from '../../lib/parent-reviews';
import IllustratedIcon from './IllustratedIcon.astro';
import Icon from './Icon.astro';
const reviews = selectParentReviews(parentReviews);
---
<section class="parent-reviews container content-section" aria-labelledby="reviews-title">
  <div class="parent-reviews-heading"><IllustratedIcon name="chat" size={88}/><div><h2 id="reviews-title">Родители об Эльбэби</h2><p>Фрагменты историй родителей с оценкой пять звёзд. Полные отзывы и все оценки — на картах.</p></div><div class="review-source-links"><a href={yandexReviewsUrl} target="_blank" rel="noopener noreferrer">Яндекс Карты <Icon name="arrow" size={18}/></a><a href={gisReviewsUrl} target="_blank" rel="noopener noreferrer">2ГИС <Icon name="arrow" size={18}/></a></div></div>
  {reviews.length > 0 && <div class="parent-reviews-list">{reviews.map(review => <figure>
    <div class="review-meta"><span>{review.source === '2gis' ? '2ГИС' : 'Яндекс Карты'}</span><div class="review-stars" aria-label="Оценка: 5 из 5">{Array.from({length:5}, () => <Icon name="star" size={18}/>)}</div></div>
    <h3>{review.topic}</h3><blockquote><p>«{review.text}»</p></blockquote>
    <figcaption><div><strong>{review.author}</strong><time datetime={review.published}>{review.date}</time></div><a href={review.sourceUrl} target="_blank" rel="noopener noreferrer">Полный отзыв <Icon name="arrow" size={18}/></a></figcaption>
  </figure>)}</div>}
</section>
