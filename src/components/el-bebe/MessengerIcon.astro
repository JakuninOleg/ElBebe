  {name === 'telegram' && <><path d="m3 11 18-7-4 16-6-5-4 3 1-6-5-1Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m8 12 9-5-6 8" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></>}
  {name === 'vk' && <path d="M3 6.5h3c.2 4.3 2.1 7 3.5 7.5V6.5h3v4.3c1.5-.2 3.3-2.3 3.9-4.3h3c-.5 2.3-2.1 4.3-3.8 5.5 1.7.9 3.8 3.1 4.4 5.5h-3.4c-.8-2-2.3-3.5-4.1-3.7v3.7H11C5.6 17.5 3.3 13.1 3 6.5Z" fill="currentColor"/>}
