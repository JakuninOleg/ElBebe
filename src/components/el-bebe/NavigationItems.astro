---
import Icon from './Icon.astro';
import { primaryNavigation } from '../../data/navigation';
interface Props { prefix: string; }
const { prefix } = Astro.props;
const current = (href: string) => Astro.url.pathname === href;
---
<ul class="nav-items">
  {primaryNavigation.map(item => <li>
    {'children' in item ? <details class="nav-group" data-nav-group id={`${prefix}-${item.id}`}>
      <summary class="nav-trigger" data-current={item.children.some(link => current(link.href)) ? 'true' : undefined}><span>{item.label}</span><Icon name="chevron" size={16}/></summary>
      <ul class="nav-submenu">{item.children.map(link => <li><a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}</a></li>)}</ul>
    </details> : <a class="nav-trigger" href={item.href} aria-current={current(item.href) ? 'page' : undefined}><span>{item.label}</span></a>}
  </li>)}
</ul>
