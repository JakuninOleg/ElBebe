---
import { responsiveImage, responsiveAvif } from '../../lib/responsive-image';
import { imageSource } from '../../lib/image-source';
import Inner from '../../layouts/Inner.astro';
import { getSiteContent } from '../../lib/cms';
import { Image } from '../../lib/emdash-ui';
import { groupPages } from '../../data/group-pages';
import IllustratedIcon from './IllustratedIcon.astro';
import Icon from './Icon.astro';
import GroupSchedules from './GroupSchedules.astro';
import GroupVideo from './GroupVideo.astro';
import Included from './Included.astro';
import Faq from './Faq.astro';
import Educators from './Educators.astro';
import { resolvePrograms } from '../../lib/group-programs';
interface Props { groupId: string; }
const { groupId } = Astro.props;
const { groups, team } = await getSiteContent();
const programs = resolvePrograms(groups);
const program = programs.find(group => group.id === groupId)!;
const page = program.page;
const photo = program.photo;
const educators = team.filter(person => person.groups.includes(groupId));
const photoSrc = imageSource(photo, `/images/el-bebe/${program.image}.webp`);
const photoResponsive = photoSrc ? responsiveImage(photoSrc) : {};
const photoAvif = photoSrc ? responsiveAvif(photoSrc) : {};
const categoryArt: Record<string, string[]> = { younger: ['lesson-speech','lesson-sensory','palette'], middle: ['lesson-english','lesson-chef','lesson-dance','lesson-support'], older: ['book','lesson-robot','lesson-finance','lesson-fitness'] };
const faqs = [
  { question: page.question, answer: page.answer },
  { question: 'Нужно ли отдельно оплачивать питание и занятия?', answer: 'Питание и все занятия по программе группы включены в стоимость посещения. На полном дне предусмотрено четыре приёма пищи: завтрак, обед, полдник и ужин. Для другого режима питание соответствует времени пребывания. Вступительный взнос указан отдельно в прайсе.', link: { href: '/stoimost/', label: 'Режимы и стоимость' } },
  { question: 'Как выбрать группу для ребёнка?', answer: 'Скажите, сколько лет ребёнку и ходил ли он раньше в сад. Мы подскажем, какая группа ему подойдёт и есть ли в ней места. До зачисления можно познакомиться с воспитателем и обсудить режим посещения.' },
  { question: 'Можно ли смотреть, как проходит день в группе?', answer: 'Да, через онлайн-камеры для родителей. Как подключиться и пользоваться трансляцией, расскажем на встрече.' },
];
---
<Inner title={`${program.title} в детском саду Эльбэби, Сочи — занятия и расписание`} heading={program.title} label={program.title} intro={page.intro} description={page.intro} art={page.art} note={page.note} parent={{ href: '/gruppy/', label: 'Наши группы' }}>
  {photoSrc && <link slot="head" rel="preload" as="image" type={photoAvif.srcset ? 'image/avif' : undefined} href={photoAvif.srcset ? undefined : photoSrc} imagesrcset={photoAvif.srcset || photoResponsive.srcset} imagesizes={photoResponsive.sizes} fetchpriority="high"/>}
  <section class={`group-detail-intro container content-section group-detail-intro--${program.accent}`} aria-labelledby="group-approach-title">
    <picture class="group-detail-photo">{photoAvif.srcset && <source type="image/avif" {...photoAvif}/>} {photo ? <Image image={photo} alt={`Занятия: ${program.title.toLowerCase()}`} width={1100} height={825} priority/> : <img src={`/images/el-bebe/${program.image}.webp`} {...responsiveImage(`/images/el-bebe/${program.image}.webp`)} alt={`Игра и занятия: ${program.title.toLowerCase()}`} width="1100" height="825" fetchpriority="high"/>}</picture>
    <div><h2 id="group-approach-title">{program.summary}</h2><p>{page.approach}</p><div class="group-detail-actions"><a class="button" href="#weekly-title">Посмотреть расписание <Icon name="arrow" size={20}/></a><button type="button" class="text-link" data-open-visit>Познакомиться с группой</button></div></div>
  </section>
  <section class="group-curriculum container content-section" aria-labelledby="curriculum-title"><div><h2 id="curriculum-title">Что есть<br/>в программе</h2><p>Занятия по расписанию чередуются с прогулками, свободной игрой и отдыхом.</p><span class="hand-note" aria-hidden="true">Каждый день<br/>что-то новое ♡</span></div><div class="curriculum-list">{program.categories.map((category, i) => <article><IllustratedIcon name={categoryArt[groupId][i]} size={72}/><div><h3>{category.title}</h3><ul>{category.activities.map(activity => <li>{activity.replace('Считаем - размышляем', 'Считаем — размышляем')}</li>)}</ul></div></article>)}</div></section>
  <div class="container content-section"><Included/></div>
  {educators.length > 0 && <Educators team={educators} heading="Воспитатели группы"/>}
  <GroupVideo groupId={groupId} title={program.title}/>
  <GroupSchedules onlyGroup={groupId}/>
  <section class="container content-section group-detail-faq"><h2>Родители спрашивают</h2><Faq items={faqs}/></section>
  <section class="group-explore container content-section" aria-labelledby="other-groups-title"><h2 id="other-groups-title">Посмотрите другие группы</h2><nav class="group-explore-links" aria-label="Другие группы">{programs.filter(group=>group.id!==groupId).map(group=><a class={`group-explore-link group-explore-link--${group.accent}`} href={`/gruppy/${groupPages[group.id].slug}/`}><img src={`/images/el-bebe/${group.image}.webp`} {...responsiveImage(`/images/el-bebe/${group.image}.webp`)} alt="" width="1100" height="825" loading="lazy"/><div><h3>{group.title}</h3><p>{group.summary}</p><span>Занятия и расписание <Icon name="arrow" size={20}/></span></div></a>)}</nav></section>
</Inner>
