---
import { responsiveImage, responsiveAvif } from '../../lib/responsive-image';
import Inner from '../../layouts/Inner.astro';
import { getSiteContent } from '../../lib/cms';
import { Image } from '../../lib/emdash-ui';
import { groupCards } from '../../data/group-cards';
import { groupPages } from '../../data/group-pages';
import { groups as schedules } from '../../data/group-schedules.json';
import IllustratedIcon from './IllustratedIcon.astro';
import Icon from './Icon.astro';
import GroupSchedules from './GroupSchedules.astro';
import GroupVideo from './GroupVideo.astro';
import Included from './Included.astro';
import Faq from './Faq.astro';
interface Props { groupId: string; }
const { groupId } = Astro.props;
const program = groupCards.find(group => group.id === groupId)!;
const page = groupPages[groupId];
const schedule = schedules.find(group => group.id === groupId)!;
const { groups } = await getSiteContent();
const photo = groups.find(group => group.id === program.id || group.title === program.title)?.image;
const photoSrc = (typeof photo === 'string' ? photo : photo?.src) || `/images/el-bebe/${program.image}.webp`;
const photoResponsive = responsiveImage(photoSrc);
const photoAvif = responsiveAvif(photoSrc);
const categoryArt: Record<string, string[]> = { younger: ['lesson-speech','lesson-sensory','palette'], middle: ['lesson-english','lesson-chef','lesson-dance','lesson-support'], older: ['book','lesson-robot','lesson-finance','lesson-fitness'] };
const faqs = [
  { question: page.question, answer: page.answer },
  { question: 'Нужно ли отдельно оплачивать питание и занятия?', answer: 'Питание и все занятия по программе группы включены в стоимость посещения. На полном дне предусмотрено четыре приёма пищи: завтрак, обед, полдник и ужин. Для другого режима питание соответствует времени пребывания. Вступительный взнос указан отдельно в прайсе.', link: { href: '/stoimost/', label: 'Режимы и стоимость' } },
  { question: 'Как выбрать группу для ребёнка?', answer: 'Расскажите о возрасте ребёнка, его интересах, привычках и опыте посещения детского сада. На знакомстве обсудим программу и подходящий режим, познакомимся с воспитателем и уточним наличие мест. Возрастные границы и условия зачисления согласуем лично.' },
  { question: 'Можно ли смотреть, как проходит день в группе?', answer: 'Да, в Эльбэби есть видеонаблюдение онлайн для родителей. На встрече расскажем, как получить доступ к трансляции и пользоваться ею. Можно заранее задать вопросы о видеонаблюдении и познакомиться с пространством сада.' },
];
---
<Inner title={`${program.title} в детском саду Эльбэби, Сочи — занятия и расписание`} heading={program.title} label={program.title} intro={page.intro} description={page.intro} art={page.art} note={page.note} parent={{ href: '/gruppy/', label: 'Наши группы' }}>
  <link slot="head" rel="preload" as="image" type={photoAvif.srcset ? 'image/avif' : undefined} href={photoAvif.srcset ? undefined : photoSrc} imagesrcset={photoAvif.srcset || photoResponsive.srcset} imagesizes={photoResponsive.sizes} fetchpriority="high"/>
  <section class={`group-detail-intro container content-section group-detail-intro--${program.accent}`} aria-labelledby="group-approach-title">
    <picture class="group-detail-photo">{photoAvif.srcset && <source type="image/avif" {...photoAvif}/>} {photo ? <Image image={photo} alt={`Занятия: ${program.title.toLowerCase()}`} width={1100} height={825} priority/> : <img src={`/images/el-bebe/${program.image}.webp`} {...responsiveImage(`/images/el-bebe/${program.image}.webp`)} alt={`Игра и занятия: ${program.title.toLowerCase()}`} width="1100" height="825" fetchpriority="high"/>}</picture>
    <div><h2 id="group-approach-title">{program.summary}</h2><p>{page.approach}</p><div class="group-detail-actions"><a class="button" href="#weekly-title">Посмотреть расписание <Icon name="arrow" size={20}/></a><button type="button" class="text-link" data-open-visit>Познакомиться с группой</button></div></div>
  </section>
  <section class="group-curriculum container content-section" aria-labelledby="curriculum-title"><div><h2 id="curriculum-title">Что есть<br/>в программе</h2><p>Занятия по расписанию чередуются с прогулками, свободной игрой и отдыхом.</p><span class="hand-note" aria-hidden="true">Каждый день<br/>что-то новое ♡</span></div><div class="curriculum-list">{schedule.categories.map((category, i) => <article><IllustratedIcon name={categoryArt[groupId][i]} size={72}/><div><h3>{category.title}</h3><ul>{category.activities.map(activity => <li>{activity.replace('Считаем - размышляем', 'Считаем — размышляем')}</li>)}</ul></div></article>)}</div></section>
  <div class="container content-section"><Included/></div>
  <GroupVideo groupId={groupId} title={program.title}/>
  <GroupSchedules onlyGroup={groupId}/>
  <section class="container content-section group-detail-faq"><h2>Родители спрашивают</h2><Faq items={faqs}/></section>
  <section class="group-explore container content-section" aria-labelledby="other-groups-title"><h2 id="other-groups-title">Посмотрите другие группы</h2><nav class="group-explore-links" aria-label="Другие группы">{groupCards.filter(group=>group.id!==groupId).map(group=><a class={`group-explore-link group-explore-link--${group.accent}`} href={`/gruppy/${groupPages[group.id].slug}/`}><img src={`/images/el-bebe/${group.image}.webp`} {...responsiveImage(`/images/el-bebe/${group.image}.webp`)} alt="" width="1100" height="825" loading="lazy"/><div><h3>{group.title}</h3><p>{group.summary}</p><span>Занятия и расписание <Icon name="arrow" size={20}/></span></div></a>)}</nav></section>
</Inner>
