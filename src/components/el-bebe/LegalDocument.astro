---
import { legalDate } from '../../data/legal-operator';
import Icon from './Icon.astro';
interface Props { sections: { id: string; title: string }[]; }
const { sections } = Astro.props;
---
<div class="container legal-layout content-section">
  <aside class="legal-contents"><div class="legal-contents-heading"><Icon name="book" size={36}/><p>В этом документе</p></div><nav aria-label="Содержание документа">{sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</nav><a class="legal-back" href="/dokumenty/"><Icon name="arrow" size={18}/>Все документы</a></aside>
  <article class="legal-body"><div class="legal-document-meta"><Icon name="calendar" size={28}/><p class="legal-version">Редакция от {legalDate}</p></div><slot/><p class="legal-endnote">Вопросы о документах? <a href="/kontakty/">Свяжитесь с садом</a>.</p></article>
</div>
