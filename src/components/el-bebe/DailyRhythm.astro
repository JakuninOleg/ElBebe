---
import { dailySchedule } from '../../data/daily-schedule';
import IllustratedIcon from './IllustratedIcon.astro';
const chapters = [
  { title: 'Утро и открытия', art: 'morning', color: 'yellow', items: dailySchedule.slice(0, 5) },
  { title: 'Обед и отдых', art: 'apple', color: 'blue', items: dailySchedule.slice(5, 9) },
  { title: 'Вторая половина дня', art: 'heart', color: 'pink', items: dailySchedule.slice(9) },
];
---
<section class="day-rhythm container content-section" id="raspisanie" aria-labelledby="rhythm-title">
  <div class="section-copy"><h2 id="rhythm-title">Распорядок дня в Эльбэби</h2><p>Общие события дня для всех групп. Занятия и точное время по будням — в <a href="/gruppy/#weekly-title">расписании вашей группы</a>.</p></div>
  <div class="day-rhythm-chapters">{chapters.map(chapter => <article class={`day-rhythm-chapter day-rhythm-chapter--${chapter.color}`}><header><IllustratedIcon name={chapter.art} size={72}/><h3>{chapter.title}</h3></header><dl>{chapter.items.map(([time, activity]) => <div><dt>{time}</dt><dd>{activity}</dd></div>)}</dl></article>)}</div>
</section>
