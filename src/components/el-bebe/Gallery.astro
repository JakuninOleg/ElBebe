---
import Icon from './Icon.astro';
import { Image } from '../../lib/emdash-ui';
import type { ImageValue } from 'emdash';
interface Props { items: Array<{ id: string; title: string; description?: string; image: ImageValue | string | null }>; full?: boolean; }
const { items, full = false } = Astro.props;
const photos = items.filter(item => item.image);
---
<div class:list={['space-gallery', { 'space-gallery--full': full }]} data-gallery>
  <div class="gallery-track" data-gallery-track style={`--photo-count:${photos.length}`}>{photos.map(item => <figure class="gallery-slide" data-gallery-slide><Image image={item.image} alt={typeof item.image === 'string' ? item.title : item.image?.alt?.replace(/^Визуализация /, '').replace(/\. Временная AI-иллюстрация El Bebe$/, '') || item.title} width={1400} height={933} loading="lazy"/><figcaption><strong>{item.title}</strong>{full && item.description && !item.description.startsWith('Временная сгенерированная визуализация.') && <span>{item.description}</span>}</figcaption></figure>)}</div>
  <div class="gallery-controls"><button type="button" data-gallery-prev aria-label="Предыдущее фото"><Icon name="chevron"/></button><div class="gallery-dots">{photos.map((item, i) => <button type="button" data-gallery-dot aria-label={`Фото ${i + 1}: ${item.title}`} aria-current={i === 0 ? 'true' : 'false'}></button>)}</div><button type="button" data-gallery-next aria-label="Следующее фото"><Icon name="chevron"/></button></div>
</div>
