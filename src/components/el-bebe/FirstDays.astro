---
import { responsiveImage } from '../../lib/responsive-image';
import Icon from './Icon.astro';
import IllustratedIcon from './IllustratedIcon.astro';
import Decor from './Decor.astro';
import Sprig from './Sprig.astro';

const details = [
  {
    icon: 'heart',
    color: 'pink',
    title: 'Первые посещения',
    text: 'До первого дня обсудим, как ребёнок привык проводить день и был ли уже в саду.',
  },
  {
    icon: 'people',
    color: 'yellow',
    title: 'Поддержка воспитателя',
    text: 'Расскажите, какие игры любит ребёнок и что помогает его успокоить, если он расстроится.',
  },
  {
    icon: 'chat',
    color: 'mint',
    title: 'Связь с родителями',
    text: 'Договоримся, как вы будете узнавать о самочувствии ребёнка и его первых днях в группе.',
  },
];
---
<section class="first-days section container" id="o-sade" aria-labelledby="first-days-title">
  <header class="first-days-heading">
    <h2 id="first-days-title">Первые дни в саду</h2>
    <p>Как проходит адаптация к детскому саду</p>
  </header>

  <div class="first-days-copy">
    <ul class="first-days-details" role="list">
      {details.map(item => <li>
        <span class={`first-days-icon first-days-icon--${item.color}`}><IllustratedIcon name={item.icon} size={64}/></span>
        <div><h3>{item.title}</h3><p>{item.text}</p></div>
      </li>)}
    </ul>
    <a class="text-link first-days-link" href="/gruppy/#adaptaciya">Подробнее о первых посещениях <Icon name="arrow" size={20}/></a>
  </div>

  <figure class="first-days-media">
    <div class="first-days-photo">
      <img src="/images/el-bebe/real-friends-square-v1.webp" {...responsiveImage('/images/el-bebe/real-friends-square-v1.webp')} alt="Дети обнимаются и смеются на прогулке" width="960" height="960" loading="lazy"/>
    </div>
    <Decor kind="drops" class="first-days-rays"/>
    <Sprig class="first-days-sprig"/>
  </figure>
</section>
