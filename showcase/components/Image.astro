---
import type { ImageValue } from 'emdash';
import { responsiveImage } from '../../src/lib/responsive-image';
interface Props { image: ImageValue | string | null; alt: string; width: number; height: number; loading?: 'lazy' | 'eager'; priority?: boolean; sizes?: string; }
const { image, alt, width, height, loading = 'lazy', priority = false, sizes } = Astro.props;
const src = typeof image === 'string' ? image : image?.src;
if (!src || !src.startsWith('/images/el-bebe/')) throw new Error('Showcase images must be curated public assets.');
---
<img src={src} {...responsiveImage(src, sizes)} alt={alt} width={width} height={height} loading={priority ? 'eager' : loading} fetchpriority={priority ? 'high' : loading === 'lazy' ? 'low' : undefined}/>
