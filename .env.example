# Node 24 / Beget VPS. Private directory outside the served application root.
EL_BEBE_PRIVATE_DB=/var/lib/el-bebe/office.sqlite
# Enable only behind the configured reverse proxy, which MUST overwrite X-Real-IP.
EL_BEBE_TRUST_LOCAL_PROXY=false
# Docker Compose supplies the exact Caddy address; leave empty for a local nginx proxy.
EL_BEBE_TRUSTED_PROXY_IPS=
# Docker/VPS instructions: docs/DOCKER-VPS.md. Secret values never go in build arguments.
# External notifications are intentionally not connected yet.
